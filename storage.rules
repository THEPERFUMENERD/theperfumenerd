rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && ((request.auth.token.keys().hasAll(['admin'])
            && request.auth.token.admin == true)
          || (request.auth.token.keys().hasAll(['email', 'email_verified'])
            && request.auth.token.email == 'perfumenerd6@gmail.com'
            && request.auth.token.email_verified == true));
    }

    function validImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    match /product-images/{adminUid}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.auth.uid == adminUid
        && (request.resource == null || validImage());
    }

    match /storefront/{adminUid}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.auth.uid == adminUid
        && (request.resource == null || validImage());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
