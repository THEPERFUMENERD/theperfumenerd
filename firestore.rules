rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && ((request.auth.token.keys().hasAll(['admin'])
            && request.auth.token.admin == true)
          || (request.auth.token.keys().hasAll(['email', 'email_verified'])
            && request.auth.token.email == 'perfumenerd6@gmail.com'
            && request.auth.token.email_verified == true));
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validCustomerProfile() {
      return request.resource.data.keys().hasOnly([
          'name', 'phoneNumber', 'address', 'city', 'region', 'postalCode', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'phoneNumber', 'address', 'city', 'region', 'postalCode', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 32
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 200
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 100
        && request.resource.data.region is string
        && request.resource.data.region.size() <= 100
        && request.resource.data.postalCode is string
        && request.resource.data.postalCode.size() <= 32
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && validCustomerProfile();
      allow delete: if false;
    }

    match /sales/{saleId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /inventoryMovements/{movementId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /posCustomerDisplays/{displayId} {
      function validDisplay() {
        return displayId.size() == 64
          && request.resource.data.keys().hasOnly([
            'displayToken', 'active', 'items', 'totalMinor', 'updatedAt'
          ])
          && request.resource.data.displayToken == displayId
          && request.resource.data.active is bool
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100
          && request.resource.data.totalMinor is int
          && request.resource.data.totalMinor >= 0
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if isAdmin()
        || (displayId.size() == 64
          && resource.data.displayToken == displayId
          && resource.data.active == true);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validDisplay();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if isAdmin() || resource.data.visible == true;
      allow create, update, delete: if isAdmin();
    }

    match /storeSettings/public {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasOnly([
          'message', 'name', 'email', 'userId', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'message', 'name', 'email', 'userId', 'status', 'createdAt'
        ])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && (request.resource.data.userId == null
          || request.resource.data.userId == request.auth.uid)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'read', 'resolved'];
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
